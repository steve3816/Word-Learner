<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↻"
            android:textSize="22sp"
            android:textColor="#555555"
            android:gravity="center"
            android:background="@drawable/widget_btn_refresh" />

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/widget_btn_add" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_word_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/widget_buttons"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_chinese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#888888"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</RelativeLayout>
